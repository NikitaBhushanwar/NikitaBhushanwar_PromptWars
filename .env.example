# The Blind Spot - Environment Variables Example
# Phase 1: Pure client architecture
# Phase 2: Google Gemini reasoning engine integration

# Gemini API Key (Required in Phase 2)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API Base URL (if using decoupled serverless microservice in Phase 2)
VITE_API_BASE_URL=http://localhost:3000

# Client Environment
VITE_APP_ENV=development
